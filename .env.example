NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (Project Settings -> API in Supabase). Server-only —
# never exposed to the browser. Used by the Strava webhook route, which has
# no logged-in user session to scope queries to.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From your app at strava.com/settings/api
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
# Any random string you make up — Strava echoes it back during webhook
# subscription setup so we can confirm the request is really from them.
STRAVA_WEBHOOK_VERIFY_TOKEN=any-random-string

# Encrypts each athlete's Garmin Connect password at rest (there's no OAuth
# to hold a token instead — see lib/garmin.ts). Generate with:
#   openssl rand -hex 32
GARMIN_CREDENTIALS_KEY=any-long-random-string
